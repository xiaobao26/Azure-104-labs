{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "10123733369884649345"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[format('toylaunch-sa{0}', uniqueString(resourceGroup().id))]"
    },
    "appServiceAppName": {
      "type": "string",
      "defaultValue": "[format('toylaunch-as{0}', uniqueString(resourceGroup().id))]"
    },
    "environmentType": {
      "type": "string",
      "allowedValues": [
        "nonprod",
        "prod"
      ]
    }
  },
  "variables": {
    "appServicePlanName": "toy-product-launch-plan-starter-072699",
    "storageAccountSkuName": "[if(equals(parameters('environmentType'), 'prod'), 'Standard_LRS', 'Standard_LRS')]",
    "appServicePlanSkuName": "[if(equals(parameters('environmentType'), 'prod'), 'F1', 'F1')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('storageAccountSkuName')]"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('appServicePlanSkuName')]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('appServiceAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "httpsOnly": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
      ]
    }
  ]
}